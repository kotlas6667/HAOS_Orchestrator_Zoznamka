{
  "name": "HAOS Orchestrator",
  "description": "AI orchestrátor pre Home Assistant — Gmail/Kalendár (noVNC login), Počasie, Discord a smart home. Elite Date, Tinder a Badoo sú samostatné add-ony.",
  "version": "1.2.33",
  "slug": "haos_orchestrator",
  "init": false,
  "arch": [
    "amd64",
    "aarch64",
    "armv7"
  ],
  "startup": "application",
  "boot": "auto",
  "ports": {
    "8000/tcp": 8000,
    "6082/tcp": 6082
  },
  "ports_description": {
    "8000/tcp": "Orchestrátor API a web dashboard",
    "6082/tcp": "noVNC — Google login (zapni google_accounts_enabled); port 6082 (Tinder 6080, Badoo 6081)"
  },
  "ingress": true,
  "ingress_port": 8000,
  "panel_icon": "mdi:robot",
  "panel_title": "Orchestrator",
  "panel_admin": false,
  "hassio_api": true,
  "homeassistant_api": true,
  "host_network": false,
  "shm_size": "256mb",
  "options": {
    "log_level": "info",
    "openai_api_key": "",
    "openai_model": "gpt-4o-mini",
    "dating_reply_model": "gpt-4o",
    "ha_url": "http://supervisor/core:8123",
    "ha_token": "",
    "weather_default_city": "Senica",
    "openweather_api_key": "",
    "discord_bot_enabled": false,
    "discord_bot_token": "",
    "discord_webhook_url": "",
    "discord_bot_channel_id": "",
    "elitedate_bot_url": "http://8c003d88-haos-elitedate:8600",
    "tinder_bot_url": "http://8c003d88-haos-tinder:8601",
    "badoo_bot_url": "http://8c003d88-haos-badoo:8602",
    "elitedate_auto_send": false,
    "tinder_auto_send": false,
    "badoo_auto_send": false,
    "dating_reply_skill": "",
    "google_accounts_enabled": false
  },
  "schema": {
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)?",
    "openai_api_key": "password",
    "openai_model": "str?",
