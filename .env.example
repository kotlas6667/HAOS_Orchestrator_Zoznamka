# HAOS Orchestrator Configuration
# Copy this file to .env and fill in your values

# ===== Application =====
APP_NAME=HAOS Orchestrator
APP_ENV=prod
APP_VERSION=1.0.0

# ===== Logging =====
LOG_LEVEL=info

# ===== AI & Routing =====
# OpenAI GPT for routing and chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Home Assistant (Primary Integration) =====
HA_PROVIDER=real
HA_URL=http://supervisor/core:8123
HA_TOKEN=
HA_TIMEOUT_SEC=10.0

# ===== Weather =====
WEATHER_PROVIDER=mock
WEATHER_DEFAULT_CITY=Senica
OPENWEATHER_API_KEY=

# ===== Discord =====
DISCORD_PROVIDER=mock
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=HAOS Orchestrator
DISCORD_TIMEOUT_SEC=8.0

# Discord Bot
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL_ID=
DISCORD_BOT_REQUIRE_MENTION=false
DISCORD_BOT_PREFIX=
DISCORD_BOT_ALLOWED_USERS=

# ===== Gmail =====
GMAIL_PROVIDER=mock
GMAIL_USER_EMAIL=me
GMAIL_CREDENTIALS_JSON=credentials.json
GMAIL_TOKEN_PICKLE=token.pickle

# ===== Calendar =====
CALENDAR_PROVIDER=mock
CALENDAR_TOKEN_PICKLE=token_calendar.pickle

# ===== Elite Date bot (separate process, see elitedate_bot/) =====
ELITEDATE_BOT_URL=http://127.0.0.1:8600
ELITEDATE_AUTO_SEND=false

# ===== Tinder bot (separate process, see tinder_bot/) =====
TINDER_BOT_ENABLED=true
TINDER_BOT_URL=http://127.0.0.1:8601
TINDER_AUTO_SEND=false
TINDER_POLL_ENABLED=true
TINDER_PAGE_SETTLE_SEC=4
TINDER_SPRAVY_SETTLE_SEC=10
TINDER_WAIT_TIMEOUT_SEC=10
TINDER_HEADLESS=true
# HA add-on: run.sh prepíše na /data/orchestrator/config/tinder/chrome-profile
TINDER_USER_DATA_DIR=tinder_bot/chrome-profile
TINDER_GEOLOCATION_ENABLED=true
TINDER_GEOLOCATION_LAT=48.1486
TINDER_GEOLOCATION_LON=17.1077
TINDER_POLL_INTERVAL_MIN_SEC=90
TINDER_POLL_INTERVAL_MAX_SEC=180
