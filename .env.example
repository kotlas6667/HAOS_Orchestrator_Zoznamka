# HAOS Orchestrator Configuration
# Copy this file to .env and fill in your values

# ===== Application =====
APP_NAME=HAOS Orchestrator
APP_ENV=prod
APP_VERSION=1.0.0

# ===== Logging =====
LOG_LEVEL=info

# ===== AI & Routing =====
# OpenAI GPT for routing and chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Silnejší model len pre ED/Tinder Discord návrhy (routing ostáva na OPENAI_MODEL)
DATING_REPLY_MODEL=gpt-4o

# ===== Home Assistant (Primary Integration) =====
HA_PROVIDER=real
HA_URL=http://supervisor/core:8123
HA_TOKEN=
HA_TIMEOUT_SEC=10.0

# ===== Weather =====
WEATHER_PROVIDER=mock
WEATHER_DEFAULT_CITY=Senica
OPENWEATHER_API_KEY=

# ===== Discord =====
DISCORD_PROVIDER=mock
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=HAOS Orchestrator
DISCORD_TIMEOUT_SEC=8.0

# Discord Bot
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL_ID=
DISCORD_BOT_REQUIRE_MENTION=false
DISCORD_BOT_PREFIX=
DISCORD_BOT_ALLOWED_USERS=

# ===== Gmail / Google Calendar (multi-account) =====
# Zapni switch (HA Nastavenia alebo dashboard → Google účty), potom prihlás účet.
# Jeden OAuth login stiahne tokeny pre Gmail aj Kalendár. Viac účtov = viac loginov.
GOOGLE_ACCOUNTS_ENABLED=false
GMAIL_PROVIDER=mock
GMAIL_USER_EMAIL=me
GMAIL_CREDENTIALS_JSON=gmailSecret.json
GMAIL_TOKEN_PICKLE=token.pickle

CALENDAR_PROVIDER=mock
CALENDAR_TOKEN_PICKLE=token_calendar.pickle
# Účty a tokeny: google_accounts.json + google_tokens/*.pickle

# ===== Elite Date / Tinder — samostatné HA add-ony =====
# Orchestrátor ich nespúšťa. DNS pre lokálne add-ony: local-{slug} (_ → -):
ELITEDATE_BOT_URL=http://local-haos-elitedate:8600
ELITEDATE_AUTO_SEND=false

TINDER_BOT_URL=http://local-haos-tinder:8601
TINDER_AUTO_SEND=false

# Spoločný skill pre AI návrhy v Discorde (ED + Tinder) — alebo HA Nastavenia textbox:
# DATING_REPLY_SKILL=Ton: prirodzeny...

# Lokálny / systemd (všetko na jednom hoste): http://127.0.0.1:8600 a :8601
# Credentials a headless nastav v Nastaveniach príslušných add-onov.
