# =============================================================================
# HAOS Elite Date Bot — /data/.env
# (vnútri add-onu haos_elitedate)
# =============================================================================

ELITEDATE_EMAIL=<SEM_ELITEDATE_EMAIL>
ELITEDATE_PASSWORD=<SEM_ELITEDATE_PASSWORD>
ELITEDATE_LOGIN_URL=https://www.elitedate.sk/prihlaseni

BOT_HOST=0.0.0.0
BOT_PORT=8600
ORCHESTRATOR_URL=http://haos_orchestrator:8000

POLL_INTERVAL_MIN_SEC=90
POLL_INTERVAL_MAX_SEC=180

HEADLESS=true
# run.sh tieto aj tak prepíše na /usr/bin/chromium
BROWSER=chrome
BROWSER_BINARY=/usr/bin/chromium
WEBDRIVER_PATH=/usr/bin/chromedriver
