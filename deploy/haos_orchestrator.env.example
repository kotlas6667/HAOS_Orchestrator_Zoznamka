# =============================================================================
# HAOS Orchestrator — /data/orchestrator/config/.env
# (vnútri add-onu haos_orchestrator)
# =============================================================================
# Sem daj hodnoty zo svojho Windows .env (OPENAI, Discord, HA token, atď.)
# NEPOUŽÍVAJ Windows cesty ani 127.0.0.1 na boty.

APP_NAME=HAOS Orchestrator
APP_ENV=prod
LOG_LEVEL=info

# ===== OpenAI =====
OPENAI_API_KEY=<SEM_OPENAI_API_KEY>
OPENAI_MODEL=gpt-4o-mini
CHAT_PROVIDER=openai

# ===== Discord =====
DISCORD_PROVIDER=webhook
DISCORD_WEBHOOK_URL=<SEM_DISCORD_WEBHOOK_URL>
DISCORD_USERNAME=Orchestrator Bot
DISCORD_TIMEOUT_SEC=8
DISCORD_BOT_ENABLED=true
DISCORD_BOT_TOKEN=<SEM_DISCORD_BOT_TOKEN>
DISCORD_BOT_CHANNEL_ID=1514534594328789055
DISCORD_BOT_REQUIRE_MENTION=false
DISCORD_BOT_PREFIX=

# ===== Počasie =====
WEATHER_PROVIDER=openweather
WEATHER_DEFAULT_CITY=Senica
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_TIMEOUT_SEC=8
WEATHER_UNITS=metric
WEATHER_LANG=sk
OPENWEATHER_API_KEY=<SEM_OPENWEATHER_API_KEY>

# ===== Gmail =====
GMAIL_PROVIDER=oauth
GMAIL_USER_EMAIL=kotlas.develop@gmail.com
GMAIL_CREDENTIALS_JSON=gmailSecret.json
GMAIL_TOKEN_PICKLE=token.pickle

# ===== Google Calendar =====
CALENDAR_PROVIDER=oauth
CALENDAR_TOKEN_PICKLE=token_calendar.pickle

# ===== Home Assistant (v add-one vždy supervisor URL) =====
HA_PROVIDER=real
HA_URL=http://supervisor/core:8123
HA_TOKEN=<SEM_HA_TOKEN>
HA_TIMEOUT_SEC=10

# ===== Dating boty — DNS slugy samostatných add-onov =====
ELITEDATE_BOT_URL=http://haos_elitedate:8600
ELITEDATE_AUTO_SEND=false

TINDER_BOT_URL=http://haos_tinder:8601
TINDER_AUTO_SEND=false
