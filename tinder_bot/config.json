{
  "name": "HAOS Tinder Bot",
  "description": "Samostatný Selenium bot pre Tinder. Prvé prihlásenie cez noVNC (port 6080) — nastav tinder_headless v Nastaveniach.",
  "version": "1.2.14",
  "slug": "haos_tinder",
  "init": false,
  "arch": ["amd64", "aarch64"],
  "startup": "application",
  "boot": "auto",
  "ports": {
    "8601/tcp": 8601,
    "6080/tcp": 6080
  },
  "ports_description": {
    "8601/tcp": "Tinder bot HTTP API (/send, /health)",
    "6080/tcp": "noVNC — jednorazové prihlásenie (tinder_headless=false)"
  },
  "hassio_api": true,
  "host_network": false,
  "shm_size": "1G",
  "options": {
    "log_level": "info",
    "tinder_headless": false,
    "orchestrator_url": "http://8c003d88-haos-orchestrator:8000",
    "poll_enabled": true,
    "login_wait_sec": 600,
    "tinder_phone": "",
    "geolocation_enabled": true,
    "geolocation_lat": "48.1486",
    "geolocation_lon": "17.1077"
  },
  "schema": {
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)?",
    "tinder_headless": "bool",
    "orchestrator_url": "str",
    "poll_enabled": "bool",
    "login_wait_sec": "int(60,3600)",
    "tinder_phone": "str?",
    "geolocation_enabled": "bool",
    "geolocation_lat": "str?",
    "geolocation_lon": "str?"
  },
  "url": "https://github.com/kotlas6667/HAOS_Orchestrator_Zoznamka",
  "maintainer": "kotlas <kotlas6667@gmail.com>"
}
