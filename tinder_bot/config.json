{
  "name": "HAOS Tinder Bot",
  "description": "Samostatný Selenium bot pre Tinder. Prvé prihlásenie cez noVNC (port 6080).",
  "version": "1.1.0",
  "slug": "haos_tinder",
  "init": false,
  "arch": ["amd64", "aarch64"],
  "startup": "application",
  "boot": "auto",
  "ports": {
    "8601/tcp": 8601,
    "6080/tcp": 6080
  },
  "ports_description": {
    "8601/tcp": "Tinder bot HTTP API (/send, /health)",
    "6080/tcp": "noVNC — jednorazové prihlásenie (TINDER_HEADLESS=false)"
  },
  "host_network": false,
  "shm_size": "512M",
  "options": {
    "log_level": "info"
  },
  "schema": {
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)?"
  },
  "url": "https://github.com/kotlas6667/haos_orchestrator_zoznamka",
  "maintainer": "kotlas <kotlas6667@gmail.com>"
}
