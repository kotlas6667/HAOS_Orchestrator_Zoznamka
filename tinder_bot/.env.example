# Copy to .env in the repo root (shared with the orchestrator's and
# elitedate_bot's .env is fine, pydantic-settings just ignores keys it
# doesn't declare).

# Tinder mostly logs in via phone OTP / Google / Facebook / Apple, not a plain
# password form. If your account happens to support email+password, fill
# these in; otherwise leave them empty and use TINDER_USER_DATA_DIR below.
TINDER_EMAIL=
TINDER_PASSWORD=
TINDER_PHONE=
TINDER_LOGIN_URL=https://tinder.com/app/login

# Persistent Chrome profile dir. Run once with TINDER_HEADLESS=false, log in
# manually (solve the OTP/captcha yourself), then switch back to headless —
# later runs reuse this saved session instead of hitting the login challenge.
TINDER_USER_DATA_DIR=

TINDER_BOT_HOST=127.0.0.1
TINDER_BOT_PORT=8601
ORCHESTRATOR_URL=http://127.0.0.1:8000

TINDER_POLL_INTERVAL_MIN_SEC=90
TINDER_POLL_INTERVAL_MAX_SEC=180

TINDER_HEADLESS=true
TINDER_BROWSER_BINARY=/usr/bin/chromium-browser
TINDER_WEBDRIVER_PATH=/usr/bin/chromedriver

# Orchestrator-side switch (in the main .env): whether a chosen reply is
# actually submitted (true) or only inserted into the chat box (false).
TINDER_AUTO_SEND=false
