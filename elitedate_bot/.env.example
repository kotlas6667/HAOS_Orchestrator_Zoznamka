# Copy to /data/.env inside the HA add-on (seedované automaticky pri prvom boote).

ELITEDATE_EMAIL=
ELITEDATE_PASSWORD=
ELITEDATE_LOGIN_URL=https://www.elitedate.sk/prihlaseni

# 0.0.0.0 — orchestrátor v druhom add-one sa musí vedieť pripojiť
BOT_HOST=0.0.0.0
BOT_PORT=8600

# DNS slug hlavného add-onu v HA supervisor sieti
ORCHESTRATOR_URL=http://haos_orchestrator:8000

POLL_INTERVAL_MIN_SEC=90
POLL_INTERVAL_MAX_SEC=180

HEADLESS=true
BROWSER_BINARY=/usr/bin/chromium
WEBDRIVER_PATH=/usr/bin/chromedriver
