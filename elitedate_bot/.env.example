# Copy to .env in the repo root (shared with the orchestrator's .env is fine,
# pydantic-settings just ignores keys it doesn't declare).
#
# V HA add-one vyplň tieto hodnoty v Nastaveniach (prednosť pred .env).

ELITEDATE_EMAIL=
ELITEDATE_PASSWORD=
ELITEDATE_LOGIN_URL=https://www.elitedate.sk/prihlaseni

BOT_HOST=127.0.0.1
BOT_PORT=8600
ORCHESTRATOR_URL=http://local-haos-orchestrator:8000

POLL_ENABLED=true
POLL_INTERVAL_MIN_SEC=90
POLL_INTERVAL_MAX_SEC=180

HEADLESS=true
CHROME_BINARY=/usr/bin/chromium-browser
CHROMEDRIVER_PATH=/usr/bin/chromedriver
