{
  "name": "HAOS Elite Date Bot",
  "description": "Samostatný Selenium bot pre Elite Date — oddelený od orchestrátora, aby Pi neťahalo dva Chromium procesy naraz.",
  "version": "1.0.0",
  "slug": "haos_elitedate",
  "init": false,
  "arch": ["amd64", "aarch64"],
  "startup": "application",
  "boot": "auto",
  "ports": {
    "8600/tcp": 8600
  },
  "ports_description": {
    "8600/tcp": "Elite Date bot HTTP API (/send, /health)"
  },
  "host_network": false,
  "shm_size": "512M",
  "options": {
    "log_level": "info"
  },
  "schema": {
    "log_level": "list(trace|debug|info|notice|warning|error|fatal)?"
  },
  "url": "https://github.com/kotlas6667/haos_orchestrator_zoznamka",
  "maintainer": "kotlas <kotlas6667@gmail.com>"
}
